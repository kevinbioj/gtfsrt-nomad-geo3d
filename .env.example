# Toutes les variables sont optionnelles, les valeurs ci-dessous sont celles par défaut.

# PORT=3000
# GTFS_RESOURCE_URL=https://gtfs.bus-tracker.fr/nomad.zip
# TRIP_UPDATES_URL=https://lrn.geo3d.hanoverdisplays.com/api-1.0/gtfs-rt/trip-updates
# VEHICLE_POSITIONS_URL=https://lrn.geo3d.hanoverdisplays.com/api-1.0/gtfs-rt/vehicle-positions
# POLL_INTERVAL_MS=15000

# Écart maximal, en secondes, entre un horaire Geo3D et l'horaire théorique de la course classique.
# MAX_TIME_DEVIATION=600

# Fichier de persistance des appariements de courses (survit aux redémarrages).
# TRIP_CACHE_PATH=data/trip-cache.json

# Rayons, en mètres, en deçà desquels un véhicule est considéré à quai / à l'approche de son prochain arrêt.
# STOPPED_AT_RADIUS=30
# INCOMING_AT_RADIUS=1500
# Recul autorisé, en mètres, lors de la reprise de la projection d'un véhicule sur son tracé.
# BACKWARD_TOLERANCE=150
# Écart maximal, en mètres, entre un véhicule et le tracé de sa course.
# MAX_SHAPE_OFFSET=150
